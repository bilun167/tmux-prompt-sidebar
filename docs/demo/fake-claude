#!/usr/bin/env python3
"""A stand-in for Claude Code in the demo: prints a made-up transcript, and
with --input reads a new prompt, runs the real tmux-claude-hook for it and
"answers" with the transcript's "=== reply <title>" part.

  fake-claude <transcript> [--input]
"""
import json
import os
import re
import subprocess
import sys
import termios
import threading
import time
import tty

HOOK = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "bin", "tmux-claude-hook")
DIM, BOLD, GREEN, RED, CYAN, MAGENTA, RESET = "\033[2m", "\033[1m", "\033[32m", "\033[31m", "\033[36m", "\033[35m", "\033[0m"
SPINNER = "⠂⠐⠠⠄"


def paint(line):
    if line.startswith("> "):
        return DIM + line + RESET
    if line.startswith("⏺"):
        return GREEN + "⏺" + RESET + re.sub(r"^ (\w+)\(", " " + BOLD + r"\1" + RESET + "(", line[1:])
    if line.startswith("  ⎿"):
        return DIM + line + RESET
    if line.startswith("✶"):
        return MAGENTA + line + RESET
    if line.startswith(" ❯"):
        return CYAN + line + RESET
    if line.startswith(" Do you"):
        return BOLD + line + RESET
    if line[:2] in ("- ", "+ "):
        return (RED if line[0] == "-" else GREEN) + line + RESET
    return line


def say(text):
    sys.stdout.write(text)
    sys.stdout.flush()


def title(text):
    subprocess.run(["tmux", "select-pane", "-t", os.environ["TMUX_PANE"], "-T", text])


def hook(event, data):
    subprocess.run([HOOK, event], input=json.dumps(data), text=True)


def read_prompt():
    """A line typed at the "> " prompt, echoed here; Enter on nothing is ignored."""
    line = ""
    while True:
        c = os.read(0, 1).decode(errors="ignore")
        if c in ("\r", "\n") and line.strip():
            say("\r\n")
            return line.strip()
        if c in ("\x7f", "\b") and line:
            line = line[:-1]
            say("\b \b")
        elif c.isprintable():
            line += c
            say(c)


def main():
    text = open(sys.argv[1]).read()
    shown, _, reply = text.partition("=== reply ")
    say("\033[?25l" + "\r\n".join(paint(l) for l in shown.rstrip("\n").split("\n")) + "\r\n")
    if "--input" not in sys.argv:
        while True:
            time.sleep(3600)
    about, _, answer = reply.partition("\n")
    tty.setraw(0, termios.TCSANOW)
    while True:
        say("\r\n" + DIM + ">" + RESET + " \033[?25h")
        prompt = read_prompt()
        say("\033[?25l")
        hook("prompt", {"prompt": prompt})
        working = threading.Event()
        working.set()

        def spin():
            i = 0
            while working.is_set():
                title(SPINNER[i % 4] + " " + about)
                i += 1
                time.sleep(0.25)
        threading.Thread(target=spin, daemon=True).start()
        for line in answer.strip("\n").split("\n"):
            time.sleep(0.9 if line.startswith("⏺") else 0.4)
            say(("\r\n" if line.startswith("⏺") else "") + paint(line) + "\r\n")
        working.clear()
        time.sleep(0.3)
        title("✳ " + about)
        hook("stop", {})


if __name__ == "__main__":
    main()
