#!/usr/bin/env python3
"""Claude Code hook: tell tmux what each Claude pane is doing.

  prompt  (UserPromptSubmit): rename the window to the prompt's first line (so
          a split window is named after its latest prompt), keep the longer
          text in the pane's @claude_prompt, state "working"
  stop    (Stop): state "done", unread unless you're looking at the pane
  notify  (Notification): state "waiting" (a question or permission prompt;
          the "waiting for your input" idle reminder is ignored)

tmux-sidebar shows these. Does nothing outside tmux.
"""
import json
import os
import subprocess
import sys

NAME_LEN = 28    # window name, also what the phone's status bar shows
PROMPT_LEN = 120


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout.strip()


def first_line(text):
    for line in text.splitlines():
        line = " ".join(line.split())
        if line:
            return line
    return ""


def clip(text, n):
    return text if len(text) <= n else text[: n - 1].rstrip() + "…"


def main():
    pane = os.environ.get("TMUX_PANE")
    event = sys.argv[1] if len(sys.argv) > 1 else ""
    if not pane:
        return
    try:
        data = json.load(sys.stdin)
    except ValueError:
        data = {}

    if event == "prompt":
        line = first_line(data.get("prompt", ""))
        if line and not line.startswith("<task-notification>"):  # a background task reporting back, not you
            tmux("rename-window", "-t", pane, clip(line, NAME_LEN))
            tmux("set", "-p", "-t", pane, "@claude_prompt", clip(line, PROMPT_LEN))
        tmux("set", "-p", "-t", pane, "@claude_state", "working")
        tmux("set", "-p", "-t", pane, "@claude_unread", "0")
    elif event == "notify" and (data.get("notification_type") == "idle_prompt"
                                or "waiting for your input" in data.get("message", "")):
        return  # sent a minute after Claude finishes: it's done, not asking anything
    elif event in ("stop", "notify"):
        tmux("set", "-p", "-t", pane, "@claude_state", "done" if event == "stop" else "waiting")
        # Being looked at: the active pane of the current window in an attached session
        looking = "#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}"
        if tmux("display", "-p", "-t", pane, looking) != "1":
            tmux("set", "-p", "-t", pane, "@claude_unread", "1")


if __name__ == "__main__":
    main()
