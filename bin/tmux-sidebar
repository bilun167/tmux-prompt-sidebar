#!/usr/bin/env python3
"""A sidebar on the right of each tmux window: sessions and their windows as a
tree, like Zed's project panel, in place of the bottom status bar.

  tmux-sidebar toggle   prefix+e by default: turn the sidebar on or off everywhere
  tmux-sidebar ensure   tmux hooks: give the current window a sidebar if it
                        should have one (on, and the client is wide enough)
  tmux-sidebar fit W    window-resized hook: set window W's sidebar to the
                        width for W's new size
  tmux-sidebar run      the sidebar itself (one per window)
  tmux-sidebar next [C] prefix+N by default: go to the pane that needs you,
                        oldest waiting first, then finished and unread; again
                        for the one after it. C: the client to switch

Each pane shows your latest prompt to Claude in it (tmux-claude-hook) and,
dimmed, Claude's own title for the conversation; once Claude exits back to the
shell, the pane's folder instead. A window split into panes
has a row per pane under its number. Marks:
  ⋯ working   ? waiting for you   ● finished since you last looked
Click a row, or j/k and Enter, to go to that window and pane; n for "next". A
× appears at the end of the row under the mouse (@sidebar_close_button: hover,
always or off); a click on it closes that pane, after a y/n unless it's a shell
at its prompt. On a touchscreen, a tap at the row's right end shows the ×. The sidebar is
@sidebar_width_pct of the client's width (default 20), kept between
@sidebar_min and @sidebar_max columns (22 and 40), and draws to whatever width
its pane has, so a drag of its border stays until the terminal is resized. On a
client narrower than @sidebar_min_width (default 120 columns, e.g. the phone)
the sidebar goes away and the bottom status bar comes back.
"""
import fcntl
import os
import re
import select
import signal
import subprocess
import sys
import termios
import textwrap
import time
import tty
import unicodedata

SEP = "|~|"  # tmux escapes control characters in -F output
SHELLS = {"bash", "zsh", "fish", "sh", "dash", "ksh", "tcsh"}
BUTTON = " × "  # ends a pane's first row while hovered, × centred; a click on it closes the pane
PRESS = 0.15   # seconds the × shows pressed before the question
HOVER_IDLE = 10  # the mouse can't be seen leaving, so a still × hides after this
FIELDS = [
    "session_name", "window_index", "window_id", "window_name", "window_active",
    "session_attached", "pane_id", "pane_index", "pane_active", "pane_title",
    "pane_current_command", "pane_current_path", "@claude_prompt", "@claude_state", "@claude_unread", "@claude_since", "@sidebar",
]


def tmux(*args):
    return subprocess.run(["tmux", *args], capture_output=True, text=True).stdout.rstrip("\n")


def opt(name, default=""):
    return tmux("show", "-gqv", name) or default


# --- toggle / ensure -------------------------------------------------------

def sidebar_panes(*scope):  # "-a" everywhere, or "-t", window
    out = tmux("list-panes", *scope, "-F", "#{pane_id} #{@sidebar}")
    return [p.split()[0] for p in out.splitlines() if p.endswith(" 1")]


def client_width():
    return int(tmux("display", "-p", "#{client_width}") or 0)


def wanted(cols):
    """Whether a client this wide gets sidebars."""
    return opt("@sidebar_on", "1") == "1" and cols >= int(opt("@sidebar_min_width", "120"))


def sidebar_width(cols):
    pct = int(opt("@sidebar_width_pct", "20"))
    return max(int(opt("@sidebar_min", "22")), min(int(opt("@sidebar_max", "40")), cols * pct // 100))


def ensure():
    # Opening a window fires two hooks at once; without the lock both add a sidebar
    lock = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", "tmux-sidebar-%d.lock" % os.getuid())
    with open(lock, "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        _ensure()


def _ensure():
    cols = client_width()
    on = wanted(cols)
    tmux("set", "status", "off" if on else "on")
    window = tmux("display", "-p", "#{window_id}")
    mine = sidebar_panes("-t", window)
    if on and not mine:
        pane = tmux("split-window", "-hfd", "-l", str(sidebar_width(cols)), "-t", window, "-P", "-F", "#{pane_id}",
                    "exec " + os.path.abspath(__file__) + " run")
        tmux("set", "-p", "-t", pane, "@sidebar", "1")
    elif on:
        for pane in mine[1:]:  # e.g. one restored by resurrect and one added since
            tmux("kill-pane", "-t", pane)
    else:
        for pane in mine:
            tmux("kill-pane", "-t", pane)


def fit_window(window):
    # tmux resizes a window you aren't looking at only when you go to it, and then
    # gives the sidebar a share of the change, so set its width again each time.
    # Not otherwise, so your own drag of its border stays.
    cols = int(tmux("display", "-p", "-t", window, "#{window_width}") or 0)
    if wanted(cols):
        for pane in sidebar_panes("-t", window):
            tmux("resize-pane", "-t", pane, "-x", str(sidebar_width(cols)))


def toggle():
    on = opt("@sidebar_on", "1") != "1"
    tmux("set", "-g", "@sidebar_on", "1" if on else "0")
    if not on:
        for pane in sidebar_panes("-a"):
            tmux("kill-pane", "-t", pane)
    ensure()


# --- next ------------------------------------------------------------------

def state(p):
    """The pane's state: working, waiting, done, or "" (a shell, or unknown)."""
    if p["pane_current_command"].lstrip("-") in SHELLS:
        return ""  # Claude has exited: what it set is stale
    s = p["@claude_state"]
    if "\u2800" <= p["pane_title"][:1] <= "\u28ff" and s != "waiting":
        return "working"  # Claude's spinner, also for sessions started before the hook
    return s


def order(p, i):
    """Sort key among panes that need you: waiting before done, then oldest first,
    then sidebar order (i) for panes from before the hook stored times."""
    since = int(p["@claude_since"]) if p["@claude_since"].isdigit() else float("inf")
    return (0 if state(p) == "waiting" else 1, since, i)


def pick(panes, current, last):
    """The pane `next` goes to: the first that needs you, or, when you're on the
    one `next` went to last time, the one after it (back to the first at the end).
    Waiting, or finished and unread; None if nothing does."""
    keys = {p["pane_id"]: order(p, i) for i, p in enumerate(panes)}
    due = sorted((keys[p["pane_id"]], p["pane_id"]) for p in panes
                 if p["pane_id"] != current and (state(p) == "waiting"
                                                 or (state(p) == "done" and p["@claude_unread"] == "1")))
    if not due:
        return None
    if current == last and current in keys:  # its ● is cleared by now, so place it by its key
        later = [pane for key, pane in due if key > keys[current]]
        if later:
            return later[0]
    return due[0][1]


def jump(client=None, current=None):
    out = tmux("list-panes", "-a", "-F", SEP.join("#{%s}" % f for f in FIELDS))
    panes = [p for p in (dict(zip(FIELDS, line.split(SEP))) for line in out.splitlines()) if p["@sidebar"] != "1"]
    at = ["-c", client] if client else []
    current = current or tmux("display", "-p", *at, "#{pane_id}")
    pane = pick(panes, current, opt("@sidebar_next_last"))
    if not pane:
        tmux("display-message", *at, "Nothing needs you")
        return
    tmux("set", "-g", "@sidebar_next_last", pane)
    tmux("switch-client", *at, "-t", pane)
    tmux("select-window", "-t", pane)
    tmux("select-pane", "-t", pane)
    tmux("set", "-p", "-t", pane, "@claude_unread", "0")


# --- the sidebar -----------------------------------------------------------

def width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 0 if unicodedata.combining(c) else 1 for c in s)


def fit(s, n):
    if width(s) <= n:
        return s + " " * (n - width(s))
    while width(s) > n - 1:
        s = s[:-1]
    return s + "…" + " " * (n - 1 - width(s))


def topic(title, host):
    # Claude prefixes its title with ✳ (idle) or a spinner while working
    t = re.sub(r"^[^\w(\[]+", "", title).strip()
    short = host.split(".")[0]
    return "" if t in ("", host, short) or t.startswith(short + ".") else t


def age(seconds):
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= n:
            return "%d%s" % (seconds // n, unit)
    return "%ds" % max(seconds, 0)


class Sidebar:
    ages = True     # @sidebar_show_age, read on each draw
    mode = "hover"  # @sidebar_close_button: hover, always or off

    def __init__(self):
        self.me = os.environ["TMUX_PANE"]
        tmux("set", "-p", "-t", self.me, "@sidebar", "1")  # also after a resurrect restore
        tmux("select-pane", "-t", self.me, "-T", "windows")  # for pane-border-status
        self.host = os.uname().nodename
        self.rows = []      # (text, style, pane id or None, first row of a pane?, its × or None)
        self.panes = {}     # pane id -> (pane, alone in its window?), for close
        self.w = 0          # the width rows are drawn at
        self.cursor = None  # keyboard selection, a row index
        self.last = None
        self.data, self.loaded = None, 0  # load()'s result and when, reused between mouse moves
        self.hot, self.hot_at = None, 0   # the pane under the mouse, and when it last moved
        self.pressed = None               # the pane whose × was just clicked
        self.asking = None                # (pane id, the confirm-before process) while it asks

    def load(self):
        """Windows in order, each a list of its panes (not counting the sidebars)."""
        out = tmux("list-panes", "-a", "-F", SEP.join("#{%s}" % f for f in FIELDS))
        windows, mywindow = {}, None
        for line in out.splitlines():
            p = dict(zip(FIELDS, line.split(SEP)))
            if p["pane_id"] == self.me:
                mywindow = p["window_id"]
            if p["@sidebar"] != "1":
                windows.setdefault(p["window_id"], []).append(p)
        return mywindow, list(windows.values())

    def label(self, p, alone):
        """A pane's name, Claude's title for it, and its mark."""
        if p["pane_current_command"].lstrip("-") in SHELLS:
            # Claude has exited: its prompt and title are stale, so show the folder
            path = p["pane_current_path"]
            home = os.path.expanduser("~")
            return ("~" if path == home else os.path.basename(path) or path), "", " "
        # Latest prompt, Claude's title under it; before the first prompt the title alone
        about = topic(p["pane_title"], self.host)
        fallback = re.sub(r"^\S+@\S+: ", "", p["window_name"]) if alone else p["pane_current_command"]
        name = p["@claude_prompt"] or about or fallback  # the Macs' zsh names windows "user@host: cmd"
        mark = {"working": "⋯", "waiting": "?"}.get(state(p), " ")
        if p["@claude_unread"] == "1" and mark == " ":
            mark = "●"
        return name, "" if about == name else about, mark

    def since(self, p, now):
        """How long the pane has been in its hook-reported state, or "" if unknown."""
        # not for a shell, nor when the spinner says working and the hook said otherwise
        if not self.ages or not p["@claude_since"].isdigit() or state(p) != p["@claude_state"]:
            return ""
        return age(int(now) - int(p["@claude_since"]))

    def buttons(self, now):
        """Which panes show a ×, and how: shown, pressed or asking."""
        out = {}
        if self.mode == "always":
            out = dict.fromkeys(self.panes, "shown")
        elif self.mode == "hover" and self.hot and now - self.hot_at < HOVER_IDLE:
            out[self.hot] = "shown"
        if self.pressed:
            out[self.pressed] = "pressed"
        if self.asking:
            out[self.asking[0]] = "asking"
        return out

    def build(self, mywindow, windows, w, now=None, buttons=None):
        now = time.time() if now is None else now
        buttons = buttons or {}
        rows = []
        session = None
        for panes in windows:
            first = panes[0]
            if first["session_name"] != session:
                session = first["session_name"]
                rows.append((fit("▾ " + session, w), "bold", None, False, None))
            mine = first["window_id"] == mywindow
            split = len(panes) > 1
            for i, p in enumerate(panes):
                name, about, mark = self.label(p, not split)
                if mark == " ":
                    mark = "·"  # so each pane's first row stands out from the lines under it
                if mine:
                    style = "current" if p["pane_active"] == "1" or not split else "bold"
                else:
                    style = {"?": "waiting", "●": "unread"}.get(mark, "")
                button = buttons.get(p["pane_id"])
                if button == "asking":
                    style = "dim"  # the question on the status line is about this row
                # "  6 ● pane 1", then "  ⋮ ● pane 2" lined up under it; ⋮ runs down the window
                dots = "⋮".ljust(len(first["window_index"]))
                number = first["window_index"] if i == 0 else dots
                head, indent = "  %s %s " % (number, mark), "  %s   " % dots
                when = " " + self.since(p, now)
                room = w - len(BUTTON)
                if when == " " or room - len(head) - len(when) < 10:  # the prompt keeps its room
                    when = ""
                # The first line leaves room for the time at its end, and for the × when it
                # always shows. A hover × goes over the line's end instead, so the rows
                # don't rewrap under the mouse.
                end = len(when) + (len(BUTTON) if self.mode == "always" else 0)
                lines = textwrap.wrap(name, w - len(indent), max_lines=2, placeholder="…",
                                      initial_indent=" " * end) or [""]
                text = head + lines[0][end:]
                if button:
                    text = fit(text, w - len(when) - len(BUTTON)) + when + BUTTON
                else:
                    text = fit(text, w - len(when)) + when
                rows.append((text, style, p["pane_id"], True, button))
                for more in lines[1:]:
                    rows.append((fit(indent + more, w), style, p["pane_id"], False, None))
                if about:
                    rows.append((fit(indent + about, w), style if mine else "dim", p["pane_id"], False, None))
        return rows

    def draw(self, reload=True):
        """Redraw; reload=False (a mouse move) reuses what tmux said less than a second ago."""
        now = time.time()
        if reload or self.data is None or now - self.loaded >= 1:
            self.data, self.loaded = self.load(), now
            self.ages = opt("@sidebar_show_age", "1") == "1"
            self.mode = opt("@sidebar_close_button", "hover")
        mywindow, windows = self.data
        if not any(panes[0]["window_id"] == mywindow for panes in windows):
            sys.exit(0)  # everything else in this window has gone: let it close
        cols, height = os.get_terminal_size()
        self.panes = {p["pane_id"]: (p, len(panes) == 1) for panes in windows for p in panes}
        self.w = max(cols - 1, 12)  # the last column would wrap
        self.rows = self.build(mywindow, windows, self.w, now, self.buttons(now))
        frame = (self.rows, self.cursor)
        if frame == self.last:
            return
        self.last = frame
        styles = {"bold": "\033[1m", "current": "\033[7;1m", "dim": "\033[2m",
                  "waiting": "\033[33;1m", "unread": "\033[32m", "": ""}
        # the × on its own: brighter than the row (or the row's own look on the
        # current row), white on red when pressed, and yellow while its question is up
        looks = {"pressed": "\033[0m\033[1;37;41m", "asking": "\033[0m\033[33;7;1m"}
        out = []
        for i, (text, style, _, _, button) in enumerate(self.rows[: height - 1]):
            sel = "\033[4m" if i == self.cursor else ""
            if button in looks:
                text = text[:-3] + looks[button] + text[-3:]
            elif button and style != "current":
                text = text[:-2] + "\033[0m\033[1m" + text[-2:]
            out.append(styles[style] + sel + text + "\033[0m")
        out.append("\033[J")
        sys.stdout.write("\033[H" + "\r\n".join(out))
        sys.stdout.flush()

    def unfocus(self):
        if tmux("display", "-p", "-t", self.me, "#{pane_active}") == "1":
            tmux("last-pane")

    def go(self, row):
        if row is None or not 0 <= row < len(self.rows) or not self.rows[row][2]:
            return
        pane = self.rows[row][2]
        self.unfocus()  # leave this window's focus where it was, not on the sidebar
        tmux("switch-client", "-t", pane)
        tmux("select-window", "-t", pane)
        tmux("select-pane", "-t", pane)
        self.cursor = None

    def close(self, row):
        """Close the row's pane, asking first unless it's a shell at its prompt
        (closing a Claude pane ends its session). The × shows pressed first."""
        if not 0 <= row < len(self.rows) or not self.rows[row][3] or self.rows[row][2] not in self.panes:
            return
        p, alone = self.panes[self.rows[row][2]]
        self.pressed = p["pane_id"]
        self.draw(reload=False)
        time.sleep(PRESS)
        self.pressed = None
        self.unfocus()
        # the window's last pane takes the window, sidebar and all, at once
        kill = "kill-window -t " + p["window_id"] if alone else "kill-pane -t " + p["pane_id"]
        if p["pane_current_command"].lstrip("-") in SHELLS:
            tmux(*kill.split())
        else:
            name = self.label(p, alone)[0].replace("#", "##")  # the prompt is a tmux format
            # Without -b it runs until the question is answered or dismissed, which
            # is when the row's mark clears (see run)
            ask = subprocess.Popen(["tmux", "confirm-before", "-p", "close %s.%s (%s)? (y/n)"
                                    % (p["window_index"], p["pane_index"], name), kill],
                                   stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            self.asking = (p["pane_id"], ask)

    def hover(self, x, row):
        """The mouse moved to column x of row: show the × of the pane under it.
        At the left edge it's on its way out, which the sidebar can't see."""
        pane = self.rows[row][2] if 0 <= row < len(self.rows) and x > 2 else None
        self.hot, self.hot_at = pane, time.time()

    def click(self, x, row):
        if x <= self.w - len(BUTTON) or self.mode == "off" or not 0 <= row < len(self.rows) or not self.rows[row][3]:
            self.go(row)
        elif self.rows[row][4]:  # the × and the space on each side of it, or the spare column after
            self.close(row)
        else:  # no × shown, as on a touchscreen: show it, and the next tap closes
            self.hot, self.hot_at = self.rows[row][2], time.time()

    def key(self, data):
        """Handle input; False when it was only mouse moves, which need no reload."""
        events = re.findall(rb"\033\[<(\d+);(\d+);(\d+)([Mm])", data)
        for button, x, y, kind in events:
            button, x, row = int(button), int(x), int(y) - 1
            if button & 32 and button & 3 == 3:  # a move with no button held
                self.hover(x, row)
            elif button == 0 and kind == b"M":
                self.click(x, row)
        if events:
            return not all(int(e[0]) & 32 for e in events)
        targets = [i for i, r in enumerate(self.rows) if r[3]]
        if not targets:
            return
        pos = targets.index(self.cursor) if self.cursor in targets else -1
        if data in (b"j", b"\033[B"):
            self.cursor = targets[min(pos + 1, len(targets) - 1)]
        elif data in (b"k", b"\033[A"):
            self.cursor = targets[max(pos - 1, 0)]
        elif data in (b"\r", b"\n"):
            self.go(self.cursor)
        elif data == b"n":
            self.cursor = None
            self.unfocus()
            window = tmux("display", "-p", "-t", self.me, "#{window_id}")
            jump(current=tmux("display", "-p", "-t", window, "#{pane_id}"))  # the window's active pane
        elif data in (b"q", b"\033"):
            self.cursor = None
            self.unfocus()

    def run(self):
        fd = sys.stdin.fileno()
        saved = termios.tcgetattr(fd)
        signal.signal(signal.SIGWINCH, lambda *_: setattr(self, "last", None))
        tty.setcbreak(fd)
        # 1003: every mouse move too, for the hover × (tmux asks the terminal for
        # moves only while a pane wants them)
        sys.stdout.write("\033[?25l\033[?1000h\033[?1003h\033[?1006h\033[2J")
        reload = True
        try:
            while True:
                if self.asking and self.asking[1].poll() is not None:
                    self.asking = None  # answered or dismissed
                self.draw(reload)
                try:
                    ready, _, _ = select.select([fd], [], [], 0.2 if self.asking else 1)
                except InterruptedError:
                    continue
                reload = True
                if ready:
                    reload = self.key(os.read(fd, 1024)) is not False
        finally:
            sys.stdout.write("\033[?1000l\033[?1003l\033[?1006l\033[?25h")
            termios.tcsetattr(fd, termios.TCSADRAIN, saved)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "run":
        try:
            Sidebar().run()
        except KeyboardInterrupt:
            pass
    elif cmd == "fit" and len(sys.argv) > 2:
        fit_window(sys.argv[2])
    elif cmd == "next":
        jump(sys.argv[2] if len(sys.argv) > 2 else None)
    elif cmd in ("toggle", "ensure"):
        {"toggle": toggle, "ensure": ensure}[cmd]()
    else:
        sys.exit(__doc__)
